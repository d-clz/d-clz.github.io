---
---
<div class="search-box">
  <input id="search-input" type="search" placeholder="Search posts (semantic)…" autocomplete="off" />
  <p id="search-status" hidden></p>
  <ul id="search-results"></ul>
</div>

<style>
  .search-box {
    position: relative;
  }
  #search-input {
    width: 100%;
    padding: 0.6rem 0.85rem;
    border: 1px solid rgba(236, 239, 244, .15);
    border-radius: 8px;
    background: rgba(0, 0, 0, .25);
    color: var(--n6);
    font-size: 0.9rem;
    font-family: inherit;
  }
  #search-input::placeholder {
    color: var(--n3);
  }
  #search-input:focus {
    outline: none;
    border-color: var(--n8);
  }
  #search-status:not([hidden]) {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 30;
    margin: 0;
    padding: 0.4rem 0.7rem;
    font-size: 0.75rem;
    color: var(--n3);
    background: linear-gradient(to bottom right, rgba(59, 66, 82, .96), rgba(46, 52, 64, .96));
    border: 1px solid rgba(236, 239, 244, .12);
    border-radius: 8px;
  }
  #search-results {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  #search-results:not(:empty) {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    z-index: 30;
    padding: 0.4rem;
    max-height: 60vh;
    overflow-y: auto;
    background: linear-gradient(to bottom right, rgba(59, 66, 82, .96), rgba(46, 52, 64, .96));
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(236, 239, 244, .12);
    border-radius: 10px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, .6);
  }
  #search-results li {
    padding: 0.6rem 0.6rem;
    border-top: 1px solid rgba(236, 239, 244, .08);
  }
  #search-results li:first-child {
    border-top: none;
  }
  #search-results a {
    font-weight: 600;
    color: var(--n8);
    text-decoration: none;
  }
  #search-results a:hover {
    text-decoration: underline;
  }
  #search-results div {
    margin-top: 0.2rem;
    font-size: 0.85rem;
    color: var(--n4);
  }
</style>

<script>
  const box = document.querySelector('.search-box');
  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');
  const status = document.getElementById('search-status');

  let indexPromise = null;
  let embedPromise = null;

  function getIndex() {
    if (!indexPromise) {
      indexPromise = fetch('/search-index.json').then((r) => {
        if (!r.ok) throw new Error(`search index not available (${r.status})`);
        return r.json();
      });
    }
    return indexPromise;
  }

  function getEmbedder() {
    if (!embedPromise) {
      embedPromise = (async () => {
        status.hidden = false;
        status.textContent = 'Loading search model…';
        const { pipeline } = await import('@xenova/transformers');
        const embed = await pipeline('feature-extraction', 'Xenova/all-MiniLM-L6-v2');
        status.hidden = true;
        return embed;
      })();
    }
    return embedPromise;
  }

  function cosineSim(a, b) {
    let dot = 0;
    for (let i = 0; i < a.length; i++) dot += a[i] * b[i];
    return dot; // embeddings are pre-normalized, so dot product == cosine similarity
  }

  function clearResults() {
    results.innerHTML = '';
    status.hidden = true;
  }

  let debounceTimer;
  input.addEventListener('focus', () => {
    getEmbedder().catch(() => {});
    getIndex().catch(() => {});
  }, { once: true });
  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    const query = input.value.trim();
    if (!query) {
      clearResults();
      return;
    }
    debounceTimer = setTimeout(() => runSearch(query), 250);
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      input.value = '';
      clearResults();
      input.blur();
    }
  });
  document.addEventListener('click', (e) => {
    if (!box.contains(e.target)) clearResults();
  });

  async function runSearch(query) {
    status.hidden = false;
    status.textContent = 'Searching…';
    try {
      const [index, embed] = await Promise.all([getIndex(), getEmbedder()]);
      const output = await embed(query, { pooling: 'mean', normalize: true });
      const queryVec = Array.from(output.data);
      const scored = index.items
        .map((item) => ({ item, score: cosineSim(queryVec, item.embedding) }))
        .sort((a, b) => b.score - a.score)
        .slice(0, 5);
      status.hidden = true;
      results.innerHTML = scored
        .map(
          ({ item }) => `
          <li>
            <a href="${item.url}">${item.title}</a>
            <div>${item.excerpt}</div>
          </li>`
        )
        .join('');
    } catch (err) {
      status.hidden = false;
      status.textContent = 'Search is unavailable right now.';
      results.innerHTML = '';
    }
  }
</script>
