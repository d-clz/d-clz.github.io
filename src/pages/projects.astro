---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/cards.css';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---
<BaseLayout title="Projects" activeNav="projects" path="~/dclz/projects">
  <div class="posts-grid">
    {projects.map((project) => (
      <a class="post-card glass-panel" href={`/projects/${project.slug}/`}>
        <span class="post-path">~/projects/{project.slug}</span>
        <h2>{project.data.title}</h2>
        <p class="post-excerpt">{project.data.tagline}</p>
        <div class="post-meta">
          {project.data.tech.map((t) => <span class="post-tag">{t}</span>)}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
