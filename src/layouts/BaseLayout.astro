---
import LiquidBackground from '../components/LiquidBackground.astro';
import '../styles/palette.css';
import '../styles/base.css';
import '../styles/background.css';
import '../styles/window.css';
import '../styles/panel.css';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'posts' | 'about';
}
const { title, description = 'Blog from my Self-Notes', activeNav } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Dclz</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <LiquidBackground />
    <div class="site-shell">
      <header class="win-header site-nav glass-panel">
        <div class="win-left">
          <div class="window-controls" aria-hidden="true">
            <i class="red"></i>
            <i class="yellow"></i>
            <i class="green"></i>
          </div>
          <a class="win-title" href="/">
            <span aria-hidden="true">📁</span>
            <span>~/dclz</span>
          </a>
        </div>
        <nav class="site-links">
          <a class={`win-action ${activeNav === 'posts' ? 'active' : ''}`} href="/">posts</a>
          <a class={`win-action ${activeNav === 'about' ? 'active' : ''}`} href="/about/">about</a>
          <a class="win-action" href="https://d-clz.github.io/portfolio/">portfolio ↗</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
